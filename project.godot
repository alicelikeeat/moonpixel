; Engine configuration file.
config_version=5

[application]

config/name="MoonPixel"
config/description="2D pixel open world sandbox / action RPG. Offline first, fully open source."
config/version="1.0.0"
run/main_scene="res://game/bootstrap/main.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://icon.svg"

[autoload]

Game="*res://game/bootstrap/game.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=30

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="mobile"
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.1, 1)
